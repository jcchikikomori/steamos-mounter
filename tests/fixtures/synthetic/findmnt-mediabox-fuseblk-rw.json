# synthetic: ntfs-3g read-write read-back of MEDIABOX (sdb5) until V-11; FUSE has an anonymous MAJ:MIN; shape of findmnt-sda1-adr-columns.json plus the MAJ:MIN column
{
   "filesystems": [
      {
         "target": "/run/media/deck/MEDIABOX",
         "source": "/dev/sdb5",
         "fstype": "fuseblk",
         "vfs-options": "rw,nosuid,nodev,relatime",
         "fs-options": "rw,user_id=0,group_id=0,allow_other,blksize=4096",
         "maj:min": "0:92"
      }
   ]
}
