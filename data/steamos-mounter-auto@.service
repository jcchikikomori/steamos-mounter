# Installed by steamos-mounter. Do not edit: install and update overwrite this file.
# Instance name: the escaped sysfs path, filled in by systemd from udev SYSTEMD_WANTS.
[Unit]
Description=steamos-mounter auto-mount for %f
BindsTo=%i.device
After=%i.device
RequiresMountsFor=/opt/steamos-mounter /var/lib/steamos-mounter
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExitType=main
KillMode=control-group
TimeoutStartSec=90
TimeoutStopSec=60
UMask=0022
SyslogIdentifier=steamos-mounter
ExecStart=/usr/bin/python3 -I /opt/steamos-mounter/bin/steamos-mounter internal reconcile --trigger start auto %f
ExecReload=/usr/bin/python3 -I /opt/steamos-mounter/bin/steamos-mounter internal reconcile --trigger reload auto %f
ExecStop=/usr/bin/python3 -I /opt/steamos-mounter/bin/steamos-mounter internal teardown auto %f
ExecStopPost=/usr/bin/python3 -I /opt/steamos-mounter/bin/steamos-mounter internal sweep auto %f
