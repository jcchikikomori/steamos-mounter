root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[bin/steamos-mounter]
indent_style = space
indent_size = 4

# Deck captures are kept byte for byte; some lines end in spaces.
[tests/fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
